# taskq — sample .env file (NFR-06: every TASKQ_* variable declared).
TASKQ_HOME=.taskq                # store path
TASKQ_MAX_WORKERS=4              # run --all pool size
TASKQ_TASK_TIMEOUT=10.0          # per-task subprocess timeout (seconds)
TASKQ_RETRY_LIMIT=2              # max retries on failed/timeout
TASKQ_BACKOFF_BASE=0.1           # retry backoff base (seconds, doubled per attempt)
TASKQ_BREAKER_THRESHOLD=3        # consecutive failures before OPEN
TASKQ_BREAKER_COOLDOWN=5.0       # OPEN -> HALF_OPEN wait (seconds)
TASKQ_CACHE_TTL=3600             # cache entry lifetime (seconds)
TASKQ_INJECT_FAULT_OK=0           # opt-in env var for --inject-fault (test/development only; gate check enforces the unset-by-default contract)
